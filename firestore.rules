rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid
                          && collection in ['clients','cattle','supply','production','expenses','health'];
    }
    // Aryan Trades (poultry ledger) — separate root so it never mixes with dairy data.
    match /at_users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid
                          && collection in ['clients','jeeps','trucks','farmPays','loads','sales','receipts','dead','stock','handovers','expenses','transfers','workers','attendance','rates','meta'];
    }
  }
}
